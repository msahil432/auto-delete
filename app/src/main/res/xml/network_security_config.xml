<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Multi Tool is an offline utility; cleartext (HTTP) traffic is completely forbidden -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
