<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude internal Room database from full backups -->
    <exclude domain="database" path="multi_tool_db" />
    <exclude domain="database" path="multi_tool_db-wal" />
    <exclude domain="database" path="multi_tool_db-shm" />
    <exclude domain="database" path="multi_tool_db-journal" />
    <!-- Exclude temporary cache directories -->
    <exclude domain="root" path="cache" />
</full-backup-content>
