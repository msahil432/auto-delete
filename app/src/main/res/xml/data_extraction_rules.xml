<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Rules for Android 12+ (API 31+) Cloud Backup -->
    <cloud-backup>
        <!-- Exclude internal Room database containing notification logs, browsing history, and usage statistics -->
        <exclude domain="database" path="multi_tool_db" />
        <exclude domain="database" path="multi_tool_db-wal" />
        <exclude domain="database" path="multi_tool_db-shm" />
        <exclude domain="database" path="multi_tool_db-journal" />
        <!-- Exclude temporary cache directories -->
        <exclude domain="root" path="cache" />
    </cloud-backup>

    <!-- Rules for Android 12+ Device-to-Device Transfer -->
    <device-transfer>
        <!-- Exclude internal Room database containing private logs from device transfers -->
        <exclude domain="database" path="multi_tool_db" />
        <exclude domain="database" path="multi_tool_db-wal" />
        <exclude domain="database" path="multi_tool_db-shm" />
        <exclude domain="database" path="multi_tool_db-journal" />
        <exclude domain="root" path="cache" />
    </device-transfer>
</data-extraction-rules>
