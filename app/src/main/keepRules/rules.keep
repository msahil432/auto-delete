# ==============================================================================
# Multi Tool - R8 Optimization & Keep Rules
# Target: AGP 9.3+ Source Set (src/main/keepRules/rules.keep)
# ==============================================================================

# 1. Stack Trace & Line Number Preservation (for deobfuscation)
# Standard for deobfuscating crash reports in Sentry/Play Console.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# 2. Strip Logging in Release Builds
# Enables R8 to remove calls to Log.v/d/i for better shrinking and obfuscation.
-assumenosideeffects class android.util.Log {
    public static boolean isLoggable(java.lang.String, int);
    public static int v(...);
    public static int d(...);
    public static int i(...);
}

# 3. Third Party Library Warning Suppression
# Suppresses warnings from dependencies that might reference missing classes.
-dontwarn org.slf4j.**
-dontwarn io.sentry.**

# 4. Native Methods (JNI)
# Retains native method names so JNI linkages from C/C++ libraries are preserved.
-keepclasseswithmembernames class * {
    native <methods>;
}

# 5. FFmpegKit
# Preserves FFmpegKit classes, callbacks, and suppress warnings for optional variants.
-keep class com.arthenica.ffmpegkit.** { *; }
-keep class com.arthenica.smartexception.** { *; }
-keep class org.ffmpeg.** { *; }
-dontwarn com.arthenica.ffmpegkit.**
-dontwarn com.arthenica.smartexception.**
-dontwarn org.ffmpeg.**

# 6. WebView JavaScript Bridge
# Preserves methods called via JavaScript interfaces from WebView.
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}

# 7. Unresolved Platform / VM References (R8 Full Mode)
# Suppresses warnings for optional classes not bundled into android.jar or device runtime.
-dontwarn sun.misc.Unsafe
-dontwarn androidx.window.extensions.**
-dontwarn androidx.window.sidecar.**
-dontwarn androidx.compose.animation.tooling.**

